{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Java Silent",
      "type": "shell",
      "command": "javac \"${file}\" && java -cp \"${fileDirname}\" ${fileBasenameNoExtension} < \"${workspaceFolder}/CodeForces/input.txt\" > \"${workspaceFolder}/CodeForces/output.txt\" && rm -f \"${fileDirname}/${fileBasenameNoExtension}.class\"",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "never",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}